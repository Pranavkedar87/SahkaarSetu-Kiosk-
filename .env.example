# Kiosk environment configuration
# Copy this file to .env.local and configure for your deployment.

# ── Required ───────────────────────────────────────────────────────────────────
# URL of the existing SahkaarSetu FastAPI backend.
# Do NOT include a trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# ── Inactivity Timeout ─────────────────────────────────────────────────────────
# Time (ms) of user inactivity before session resets to language selection.
# Default: 120000 (2 minutes). Minimum recommended: 60000 (1 minute).
VITE_KIOSK_INACTIVITY_TIMEOUT_MS=120000

# ── Warning Lead Time ──────────────────────────────────────────────────────────
# How many ms before timeout the warning dialog is shown.
# Default: 20000 (20 seconds before timeout).
VITE_KIOSK_TIMEOUT_WARNING_MS=20000

# ── SECURITY — NEVER ADD TO FRONTEND ─────────────────────────────────────────
# The following secrets must NEVER be placed in this file or any frontend file:
#   GEMINI_API_KEY
#   BHASHINI_API_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_SERVICE_KEY
#   JWT_SECRET
#   ADMIN_PASSWORD
# All AI/database calls must go through the FastAPI backend.
